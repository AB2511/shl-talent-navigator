# LLM Configuration
LLM_PROVIDER=gemini  # Options: gemini, openrouter, groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash  # Recommended: gemini-1.5-flash (free tier available)

# Get free Gemini API key from: https://aistudio.google.com/
# Note: Use gemini-1.5-flash (NOT gemini-pro due to endpoint changes)

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
